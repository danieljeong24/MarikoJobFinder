# Copy to .env and fill in. .env is git-ignored.

# USAJOBS API (free key: https://developer.usajobs.gov/apirequest/)
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# SMTP for --email (Gmail: smtp.gmail.com / 587 / an App Password)
JOB_WATCH_SMTP_HOST=smtp.gmail.com
JOB_WATCH_SMTP_PORT=587
JOB_WATCH_SMTP_USER=
JOB_WATCH_SMTP_PASSWORD=
JOB_WATCH_SMTP_FROM=
# Comma-separated list
JOB_WATCH_SMTP_TO=
# Set to 1 to use implicit SSL (port 465) instead of STARTTLS
JOB_WATCH_SMTP_SSL=0
